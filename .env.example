# ============================================================================
# SAMAJH (سمجھ) — SERVER-SIDE API KEY & MODEL CONFIGURATION
# ============================================================================
# SECURITY RULE: Never put real API keys in client-side code or commit them to Git.
#
# HOW TO USE YOUR API KEY:
# 1. In Google AI Studio: Open the "Settings > Secrets" panel and add any of the
#    variables below (e.g., GEMINI_API_KEY or GROQ_API_KEY).
# 2. When self-hosting locally: Copy this file to `.env` (which is git-ignored)
#    and paste your key next to the appropriate provider variable below.
# ============================================================================

# --- OPTION 1: Google Gemini API (Default) ---
# Put your Gemini API key here (or in AI Studio Settings > Secrets):
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Default model ID ("gemini-4-argon" or "gemini-3.8-flash"):
GEMINI_MODEL="gemini-3.8-flash"

# --- OPTION 2: Groq Vision API (for keys starting with gsk_...) ---
# Put your Groq API key (gsk_...) here in your local `.env` or AI Studio Secrets:
GROQ_API_KEY=""
# Default Groq multimodal vision model:
GROQ_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# --- OPTION 3: Any OpenAI-Compatible Vision API (OpenAI, OpenRouter, Together, vLLM) ---
# Put your custom provider API key, base URL, and model ID here:
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_BASE_URL="https://api.openai.com/v1"
CUSTOM_LLM_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
